# Supabase (backend)
SUPABASE_URL=https://your-project.supabase.co
# Service role — server only, never expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable — used for sign-in / sign-up on the backend auth client
SUPABASE_ANON_KEY=
# Legacy fallback if SERVICE_ROLE_KEY is unset (not recommended)
SUPABASE_KEY=

# Forecast models (Supabase Storage + nightly cron)
FORECAST_STORAGE_BUCKET=forecast-models
FORECAST_STORAGE_ENABLED=true
FORECAST_SYNC_ON_STARTUP=true
# Shared secret: Edge Function Bearer token and API FORECAST_CRON_SECRET must match
FORECAST_CRON_SECRET=change-me-to-a-long-random-string
# Public HTTPS URL of this FastAPI server (NOT localhost — Supabase Edge Functions run in the cloud)
TRAINING_WORKER_URL=https://your-api.example.com

# Optional: for `npx supabase secrets set` on Windows (create at dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=sbp_...

# NVIDIA NIM (https://integrate.api.nvidia.com/v1) — used for chatbot + account hub LLM
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_ACCOUNT_HUB_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
